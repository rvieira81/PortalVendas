@inject IOptions<PortalVendas.Infrastructure.Servicos.LojaOptions> Loja
@{
    var nomeLoja = Loja.Value.Nome;
    var titulo = ViewData["Title"] as string;
    var cnpj = string.IsNullOrEmpty(Loja.Value.Cnpj) ? "" : $", CNPJ {Loja.Value.Cnpj}";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#12343B" />
    <title>@(string.IsNullOrEmpty(titulo) ? nomeLoja : $"{titulo} | {nomeLoja}")</title>
    @if (ViewData["Descricao"] is string descricao)
    {
        <meta name="description" content="@descricao" />
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600..800&family=Figtree:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="~/img/favicon.svg" type="image/svg+xml" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    <a class="visually-hidden-focusable pular" href="#conteudo">Pular para o conteúdo</a>

    <header class="topo">
        <div class="container topo-linha">
            <a class="marca" href="/" aria-label="@nomeLoja — página inicial">
                <img src="~/img/favicon.svg" alt="" width="34" height="34" />
                <span>@nomeLoja</span>
            </a>

            <form class="busca" role="search" action="/busca" method="get">
                <label for="busca-topo" class="visually-hidden">Buscar produtos</label>
                <input id="busca-topo" type="search" name="q" placeholder="Buscar produtos"
                       value="@Context.Request.Query["q"]" maxlength="100" autocomplete="off" />
                <button type="submit">Buscar</button>
            </form>

            <nav class="topo-acoes" aria-label="Sua conta">
                @if (User.EhAdministrador())
                {
                    <a class="topo-link" href="/admin">Painel admin</a>
                }
                else if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="topo-link" href="/pedidos">Meus pedidos</a>
                }

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown">
                        <button class="topo-link dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Olá, @(User.Identity.Name?.Split(' ')[0])
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @if (!User.EhAdministrador())
                            {
                                <li><a class="dropdown-item" href="/minha-conta">Meus dados</a></li>
                                <li><a class="dropdown-item" href="/minha-conta/enderecos">Endereços</a></li>
                                <li><a class="dropdown-item" href="/pedidos">Meus pedidos</a></li>
                                <li><hr class="dropdown-divider" /></li>
                            }
                            <li>
                                <form method="post" action="/conta/sair" asp-antiforgery="true">
                                    <button type="submit" class="dropdown-item">Sair</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="topo-link" href="/conta/entrar?returnUrl=@Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString)">Entrar</a>
                }

                @if (!User.EhAdministrador())
                {
                    <a class="carrinho-botao" href="/carrinho">
                        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 4h2l2.4 11.2a1.5 1.5 0 0 0 1.5 1.2h8.6a1.5 1.5 0 0 0 1.5-1.1L21 8H6.2"/><circle cx="9.5" cy="20" r="1.4" fill="currentColor"/><circle cx="17.5" cy="20" r="1.4" fill="currentColor"/></svg>
                        <span>Carrinho</span>
                        @await Component.InvokeAsync("ResumoCarrinho")
                    </a>
                }
            </nav>
        </div>
    </header>

    <main id="conteudo" class="flex-grow-1">
        @if (TempData.Peek("Sucesso") is not null || TempData.Peek("Aviso") is not null || TempData.Peek("Erro") is not null)
        {
            <div class="container pt-4"><partial name="_Mensagens" /></div>
        }
        @if (ViewData["LarguraTotal"] is true)
        {
            @RenderBody()
        }
        else
        {
            <div class="container py-4 pb-5">@RenderBody()</div>
        }
    </main>

    <footer class="rodape">
        <div class="container">
            <div class="rodape-grade">
                <div>
                    <strong class="rodape-marca">@nomeLoja</strong>
                    <p>Pague com Pix, cartão em até 12x ou boleto. Frete calculado pelo seu CEP antes de fechar o pedido.</p>
                </div>
                <div>
                    <strong>Atendimento</strong>
                    <p>
                        <a href="mailto:@Loja.Value.EmailAtendimento">@Loja.Value.EmailAtendimento</a>
                        @if (!string.IsNullOrEmpty(Loja.Value.TelefoneAtendimento))
                        {
                            <text><br />@Loja.Value.TelefoneAtendimento</text>
                        }
                    </p>
                </div>
                <div>
                    <strong>A loja</strong>
                    <p><a href="/termos">Termos de uso</a><br /><a href="/privacidade">Política de privacidade</a></p>
                </div>
            </div>
            <p class="rodape-legal">&copy; @DateTime.Now.Year @(nomeLoja + cnpj). Pagamentos processados pelo Mercado Pago.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
