@model MinhaContaViewModel
@{
    ViewData["Title"] = "Minha conta";
}
<div class="row g-4">
    <div class="col-md-3"><partial name="_MenuConta" /></div>
    <div class="col-md-9">
        <h1 class="h3 mb-4">Meus dados</h1>

        @if (!Model.EmailConfirmado)
        {
            <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span>Seu e-mail ainda não foi confirmado. Confirme para poder finalizar compras.</span>
                <form method="post" action="/conta/reenviar-confirmacao" asp-antiforgery="true">
                    <button class="btn btn-sm btn-warning">Reenviar e-mail</button>
                </form>
            </div>
        }

        <div class="card mb-4">
            <div class="card-body">
                <dl class="row mb-3">
                    <dt class="col-sm-3">E-mail</dt><dd class="col-sm-9">@Model.Email</dd>
                    <dt class="col-sm-3">CPF</dt><dd class="col-sm-9">@Model.CpfMascarado</dd>
                </dl>
                <form method="post" action="/minha-conta" asp-antiforgery="true" novalidate>
                    <div class="row g-3">
                        <div class="col-sm-7">
                            <label asp-for="Nome" class="form-label"></label>
                            <input asp-for="Nome" class="form-control" autocomplete="name" />
                        </div>
                        <div class="col-sm-5">
                            <label asp-for="Telefone" class="form-label"></label>
                            <input asp-for="Telefone" class="form-control" data-mascara="telefone" inputmode="tel" maxlength="15" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary mt-3">Salvar</button>
                </form>
                <p class="small text-muted mt-3 mb-0">Para trocar e-mail ou CPF, fale com o atendimento.</p>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h2 class="h5">Alterar senha</h2>
                <form method="post" action="/minha-conta/alterar-senha" asp-antiforgery="true" novalidate>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="SenhaAtual" class="form-label">Senha atual</label>
                            <input id="SenhaAtual" name="SenhaAtual" type="password" class="form-control" autocomplete="current-password" required />
                        </div>
                        <div class="col-md-4">
                            <label for="NovaSenha" class="form-label">Nova senha</label>
                            <input id="NovaSenha" name="NovaSenha" type="password" class="form-control" autocomplete="new-password" minlength="8" required />
                        </div>
                        <div class="col-md-4">
                            <label for="ConfirmarSenha" class="form-label">Repita a nova senha</label>
                            <input id="ConfirmarSenha" name="ConfirmarSenha" type="password" class="form-control" autocomplete="new-password" minlength="8" required />
                        </div>
                    </div>
                    <p class="small text-muted mt-2">Ao trocar a senha, as sessões abertas em outros dispositivos são encerradas.</p>
                    <button type="submit" class="btn btn-outline-primary">Alterar senha</button>
                </form>
            </div>
        </div>
    </div>
</div>
