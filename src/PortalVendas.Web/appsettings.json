{
  "ConnectionStrings": {
    "PortalVendas": "Server=localhost;Database=PortalVendas;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=True;Application Name=PortalVendas"
  },
  "Licenca": {
    "Arquivo": "licenca.lic"
  },
  "Loja": {
    "UrlBase": "https://localhost:7180",
    "EmailAtendimento": "atendimento@sualoja.com.br",
    "TelefoneAtendimento": ""
  },
  "MercadoPago": {
    "UrlBase": "https://api.mercadopago.com/",
    "AccessToken": "",
    "PublicKey": "",
    "SegredoWebhook": "",
    "UrlNotificacao": "",
    "NomeNaFatura": "PORTALVENDAS",
    "TimeoutSegundos": 20
  },
  "MelhorEnvio": {
    "UrlBase": "https://sandbox.melhorenvio.com.br/",
    "Token": "",
    "EmailContato": "ti@sualoja.com.br",
    "Servicos": "",
    "AvisoRecebimento": false,
    "MaoPropria": false,
    "TimeoutSegundos": 8,
    "CacheMinutos": 10
  },
  "Smtp": {
    "Host": "",
    "Porta": 587,
    "UsarSsl": true,
    "Usuario": "",
    "Senha": "",
    "Remetente": "nao-responda@sualoja.com.br",
    "NomeRemetente": "Portal de Vendas",
    "PastaArquivos": ""
  },
  "Imagens": {
    "Pasta": "imagens",
    "CaminhoPublico": "/imagens"
  },
  "DataProtection": {
    "PastaChaves": "",
    "ProtegerComDpapi": true
  },
  "Manutencao": {
    "Habilitada": true,
    "IntervaloMinutos": 5
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/portal-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}